# Servidor
PORT=4000
NODE_ENV=development

# Base de datos (MySQL 5.7)
DB_HOST=localhost
DB_NAME=dumont
DB_USER=root
DB_PASSWORD=changeme
# true para ver el SQL de Sequelize en consola
DB_LOGGING=false

# Auth
# OBLIGATORIO, recomendado 32+ caracteres aleatorios (el servidor no arranca sin él). También
# cifra los secretos de la verificación en 2 pasos: si lo cambiás, los usuarios
# con 2FA tendrán que volver a configurarla.
JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiYWRtaW4iOnRydWUsImlhdCI6MTUxNjIzOTAyMn0.KMUFsIDTnFmyG3nMiGM6H9FNFUROf3wh7SmqJp-QV30
# Duración de la sesión del panel (por defecto 12h)
# JWT_EXPIRES_IN=12h

# OPCIONAL. Las URLs de los archivos subidos a disco local se arman solas con
# el dominio con el que llega el pedido (ej. https://dumont-back.onrender.com).
# Definí esto solo si necesitás forzar otro dominio público para el BACKEND
# (nunca el del frontend).
# PUBLIC_BASE_URL=https://dumont-back.onrender.com

# CORS: orígenes del FRONTEND separados por comas. Sin definir: localhost:3000 y dumont.onrender.com
CORS_ORIGINS=http://localhost:3000,https://dumont.onrender.com
# Permitir IPs de red local (192.168.x.x, 10.x.x.x, 172.16-31.x.x):3000. Por defecto true fuera de producción.
CORS_ALLOW_LAN=true

# Datos de contacto de soporte que muestra la tablet
SOPORTE_TELEFONO=+54 11 0000-0000
SOPORTE_WHATSAPP=5491100000000
SOPORTE_EMAIL=soporte@example.com

# Cloudinary (opcional). Si se define, los archivos se suben ahí en vez de a disco.
# Opción 1:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Opción 2 (alternativa a CLOUDINARY_URL):
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Mail de verificación de usuarios (SMTP). Si no se completa, los usuarios nuevos
# quedan verificados automáticamente (sin enviar mail).
# Ejemplo Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USER=tucuenta@gmail.com,
# MAIL_PASS=<contraseña de aplicación de 16 letras> (requiere verificación en 2 pasos en Google).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=eliumnova@gmail.com
MAIL_PASS=lxjo pevg skgu rpji
# Remitente que se muestra (opcional)
# MAIL_FROM=DuMont <no-reply@tudominio.com>
# URL pública del FRONTEND, usada en el enlace del mail (opcional; por defecto la del navegador de quien registra)
# FRONTEND_URL=https://dumont.onrender.com
# AWS SNS (SMS de verificación)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PUBLIC_BASE_URL=https://dumont-back.onrender.com