# URL pública del BACKEND (sin barra final). Next lo usa para proxy /api y para las llamadas axios.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Token de Mapbox para el geolocalizador
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.xxxxx

# Solo desarrollo: hosts desde los que se abre el front (tablet/celular en la LAN), separados por comas
ALLOWED_DEV_ORIGINS=192.168.0.15
